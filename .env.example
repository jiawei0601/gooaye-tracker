# AI Studio 的 Gemini API key（https://aistudio.google.com/apikey，新版金鑰為 AQ. 開頭）
# 注意：環境變數裡 Antigravity 的 GEMINI_API_KEY 打不通 Gemini API，一定要用這裡的專案金鑰
GOOAYE_GEMINI_KEY=

# --- 轉錄通道（analyze.py）---
# gemini（預設）＝Gemini 直接聽音檔；whisper＝Colab T4 的 faster-whisper 轉錄 + Gemini 文字分析
# Vertex 到期後一行切換：GOOAYE_TRANSCRIBER=whisper
GOOAYE_TRANSCRIBER=gemini
# gemini 通道遇 429／RESOURCE_EXHAUSTED／403／PERMISSION_DENIED／billing 時自動改走 Whisper（1＝啟用、0＝停用）
GOOAYE_WHISPER_FALLBACK=1
# colab CLI 路徑；留空則用 PATH 上的 colab（安裝：uv tool install google-colab-cli，需使用者本人登入）
COLAB_BIN=
